{
	"cmake.configureOnOpen": false,
	"C_Cpp.default.includePath":
			["${default}",
			 "${workspaceFolder}/cycles/src",
			 "${workspaceFolder}/cycles/src/ccycles",
			 "${workspaceFolder}/cycles/src/**",
			 "${workspaceFolder}/cycles/third_party/**",
			 "${workspaceFolder}/cycles/lib/windows_x64/**/include",
			 "${workspaceFolder}/**"
			],
	"C_Cpp.default.defines" : [
			"CCL_NAMESPACE_BEGIN=namespace ccl {",
			"CCL_NAMESPACE_END=}",
			"WITH_CUDA_DYNLOAD",
			"__CUDA_ARCH__"],
	"files.associations": {
		"*.u3m": "json",
		"vector": "cpp",
		"fstream": "cpp",
		"istream": "cpp",
		"streambuf": "cpp",
		"condition_variable": "cpp",
		"cstdlib": "cpp",
		"future": "cpp",
		"mutex": "cpp"
	}
}
