{
  "tasks" : [
    {
      "label": "copy ccycles.cpp to ccycles src",
      "type": "shell",
      "command": "cp /harvester/shadernodes_cs/ccycles.cpp /cycles/src/ccycles/ccycles.cpp",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "copy C# shadernodes to csycles",
      "type": "shell",
      "command": "cp /harvester/shadernodes_cs/*Node.cs /csycles/ShaderNodes/.",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "copy pinvoke to csycles",
      "type": "shell",
      "command": "cp /harvester/shadernodes_cs/CSycles.cs /csycles/.",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "copy toplevel to csycles",
      "type": "shell",
      "command": "find /harvester/shadernodes_cs/ -maxdepth 1 -type f -name \"*.cs\" ! -name \"*Node.cs\" ! -path \"*/extra/*\" ! -name \"*.post\" ! -name \"*.template\" -print0 | xargs -0 cp -t /csycles/",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "copy manual cs",
      "type": "shell",
      "command": "rsync -av --exclude='*.template' --exclude='*extra*' /harvester/manualcs/. /csycles/.",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "copy all",
      "type": "shell",
      "command": "ls -ahl",
      "group": "none",
      "dependsOn": [
        "copy ccycles.cpp to ccycles src",
        "copy C# shadernodes to csycles",
        "copy pinvoke to csycles",
        "copy toplevel to csycles",
        "copy manual cs",
      ],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "/harvester"
      },
      "problemMatcher": []
    },
    {
      "label": "clear out shadernodes",
      "type": "shell",
      "command": "rm -f /csycles/ShaderNodes/*.cs"
    },
    {
      "label": "clear out csycles toplevel",
      "type": "shell",
      "command": "rm -f /csycles/*.cs"
    },
    {
      "label": "clear and copy",
      "type": "shell",
      "command": "echo 'Clearing out and copying'",
      "dependsOn": [
        "clear out shadernodes",
        "clear out csycles toplevel",
        "copy all"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "clear all",
      "type": "shell",
      "command": "echo 'Clearing out all generated files'",
      "dependsOn": [
        "clear out shadernodes",
        "clear out csycles toplevel"
      ],
      "dependsOrder": "sequence",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "make release cycles",
      "type": "shell",
      "command": "cd /cycles && clear && make release",
      "group": "none",
      "dependsOn": "copy ccycles.cpp to ccycles src",
      "problemMatcher": []
    },
    {
      "label": "Generate Wrapper code",
      "type": "shell",
      "command": "python3 /harvester/generate_shader_nodes.py datatypes.json shadernodes_cs",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "run unix2dos",
      "type": "shell",
      "command": "find /csycles -type f -name \"*.cs\" | xargs unix2dos"
    },
    {
      "label": "Generate Wrapper and copy",
      "type": "shell",
      "command": "echo 'Generating wrapper code and copying to csycles'",
      "dependsOn": [
        "clear all",
        "Generate Wrapper code",
        "copy all",
        "run unix2dos",
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}