{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CClHarvest (container)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ccl_harvest.py",
      "console": "integratedTerminal",
      "args": [
        "/cycles/src/",
        "/cycles/lib/linux_x64/",
        "/cycles/third_party"
      ]
    },
    {
      "name": "Debug CClHarvest (short container)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ccl_harvest.py",
      "console": "integratedTerminal",
      "args": [
        "/cycles/src/scene/shader_nodes.cpp",
        "/cycles/lib/linux_x64/",
        "/cycles/third_party"
      ]
    },
    {
      "name": "Debug CClHarvest (mesh short container)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ccl_harvest.py",
      "console": "integratedTerminal",
      "args": [
        "/cycles/src/scene/mesh.cpp",
        "/cycles/lib/linux_x64/",
        "/cycles/third_party"
      ]
    },
    {
      "name": "Debug Shadernodes Generation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/generate_shader_nodes.py",
      "console": "integratedTerminal",
      "args": [
        "datatypes.json",
        "shadernodes_cs"
      ],
      "postDebugTask": "clear and copy",
    },
    {
      "name": "Nvim Debug Shadernodes Generation",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "args": [
        "datatypes.json",
        "shadernodes_cs"
      ]
    }
  ]
}
