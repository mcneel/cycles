<?xml version="1.0" encoding="utf-8"?>
<!--
  Builds native Cycles + ccycles from inside Rhino.sln.

  Cycles is a CMake project, which cannot be referenced from a .sln directly.
  This is a Makefile-style vcxproj that drives cycles/build_cycles.ps1, so
  Build and Rebuild in Visual Studio do the right thing and errors surface in
  the Error List like any other project.

  Nothing has to be switched on. tools/cycles_build_if_needed.ps1 compares the
  Cycles sources against the fingerprint the prebuilt payload was stamped with,
  and builds only when they differ:

    unchanged
        Does nothing. The prebuilt ccycles binaries are restored by
        RhinoCyclesCore.csproj. Nobody needs CMake, CUDA or an OptiX SDK
        to build Rhino.

    changed
        Configures and builds Cycles from source, installs it into big_libs and
        re-stamps it. GPU backends are auto-detected; a machine with no GPU SDKs
        installed still gets a working CPU-only build, and one with no CMake at
        all is told rather than blocked.

    Note that this project installs into big_libs, and it is
    RhinoCyclesCore.csproj that copies from there into the plug-in output. So
    building this project on its own updates big_libs but leaves the ccycles.dll
    that Rhino actually loads untouched, and the next run silently uses the old
    one. Build RhinoCyclesCore, or the solution, to deploy. Comparing the two
    timestamps is the quickest way to catch it.
-->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="ReleaseDebuggable|x64">
      <Configuration>ReleaseDebuggable</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{4374CB1D-D754-4248-811B-A2B660EC79E3}</ProjectGuid>
    <RootNamespace>ccycles</RootNamespace>
    <Keyword>MakeFileProj</Keyword>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'!='Debug'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <!-- build_cycles.ps1 understands Debug / Release / RelWithDebInfo. -->
    <CyclesConfiguration>Release</CyclesConfiguration>
    <CyclesConfiguration Condition="'$(Configuration)'=='Debug'">Debug</CyclesConfiguration>
    <CyclesConfiguration Condition="'$(Configuration)'=='ReleaseDebuggable'">RelWithDebInfo</CyclesConfiguration>

    <CyclesScript>$(MSBuildThisFileDirectory)..\..\build_cycles.ps1</CyclesScript>
    <!-- RhinoBinDir comes from Rhino's property sheets, which a Makefile-style
         project does not import, so it is empty when building from Rhino.sln and
         the install path came out as "\Release\Plug-ins" - the drive root.
         Derive the same location from this file, and let RhinoBinDir win when a
         caller does set it.
           src/ccycles -> src -> cycles -> RDK -> Plug-ins -> rhino4 -> src4 -->
    <CyclesBinDir Condition="'$(RhinoBinDir)'!=''">$(RhinoBinDir)</CyclesBinDir>
    <CyclesBinDir Condition="'$(RhinoBinDir)'==''">$(MSBuildThisFileDirectory)..\..\..\..\..\..\bin</CyclesBinDir>
    <!-- Install into big_libs rather than straight into bin. That is where the
         prebuilt Cycles lives, and RhinoCyclesCore copies from there into bin for
         everyone - so building Cycles now updates the prebuilt payload and takes
         the same path into the output as a normal build. One tick of "Cycles
         Core" in RhinoBuilder therefore does the whole job, and what a developer
         who rebuilt Cycles ends up running is exactly what everyone else gets.
         Commit the big_libs change afterwards to share it. -->
    <CyclesPayloadDir>release</CyclesPayloadDir>
    <CyclesPayloadDir Condition="'$(Configuration)'=='Debug'">debug</CyclesPayloadDir>
    <CyclesInstallDir>$(MSBuildThisFileDirectory)..\..\..\..\..\..\..\big_libs\RhinoCycles\ccycles\win\$(CyclesPayloadDir)</CyclesInstallDir>
    <CyclesBuildDir>$(MSBuildThisFileDirectory)..\..\build</CyclesBuildDir>

    <!--
      Decide, do not ask.

      ccycles is rebuilt when the Cycles sources differ from the ones the
      prebuilt payload was built from, and not otherwise. Nobody has to set
      anything: change Cycles, build Rhino with RhinoBuilder or Visual Studio,
      and ccycles and its kernels are regenerated. Change nothing and this costs
      one PowerShell start, where Rhino 9.x cost nothing at all because it never
      built Cycles from a normal solution build.

      The comparison lives in tools/cycles_build_if_needed.ps1, which explains
      why it is content-derived rather than timestamp-based: git rewrites mtimes
      on checkout, so timestamps would make a fresh clone a coin flip.

      Rebuild forces a from-scratch build by clearing the build directory first.
      Clean deliberately leaves it alone - wiping an hour of CMake output is not
      something Clean Solution should do as a side effect.
    -->
    <CyclesDecide>powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildThisFileDirectory)..\..\tools\cycles_build_if_needed.ps1" -Configuration $(CyclesConfiguration) -InstallDir "$(CyclesInstallDir)"</CyclesDecide>

    <NMakeBuildCommandLine>$(CyclesDecide)</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>rmdir /s /q "$(CyclesBuildDir)" 2&gt;nul &amp; $(CyclesDecide)</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>echo ccycles: leaving the Cycles build tree in cycles\build. Rebuild wipes it for a from-scratch build.</NMakeCleanCommandLine>

    <NMakeOutput>$(CyclesInstallDir)\ccycles.dll</NMakeOutput>

    <!-- Gives IntelliSense something to work with when browsing ccycles sources. -->
    <NMakePreprocessorDefinitions>CCL_CAPI_DLL;WITH_CUDA_DYNLOAD;$(NMakePreprocessorDefinitions)</NMakePreprocessorDefinitions>
    <NMakeIncludeSearchPath>$(MSBuildThisFileDirectory)cycles\src;$(MSBuildThisFileDirectory)cycles\third_party;$(NMakeIncludeSearchPath)</NMakeIncludeSearchPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\build_cycles.ps1" />
    <None Include="CMakeLists.txt" />
    <None Include="ccycles_manifest.xml.in" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
