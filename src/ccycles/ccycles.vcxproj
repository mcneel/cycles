<?xml version="1.0" encoding="utf-8"?>
<!--
  Builds native Cycles + ccycles from Rhino.sln or Cycles.sln: a Makefile-style project
  driving build_cycles.ps1, since a .sln cannot reference CMake directly.

    Debug / Release / ReleaseDebuggable
        Does nothing; RhinoCyclesCore.csproj restores the prebuilt binaries.
    Debug+Cycles / ReleaseDebuggable+Cycles
        Builds Cycles from source into big_libs. GPU backends are auto-detected;
        with no GPU SDKs you still get a CPU-only build. Cycles.sln's Debug and
        Release build these.

  A +Cycles build then deploys the payload into an existing src4/bin/Debug or bin/Release
  with RhinoCyclesCore's deploy targets, so building only Cycles refreshes Rhino.
-->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="ReleaseDebuggable|x64">
      <Configuration>ReleaseDebuggable</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug+Cycles|x64">
      <Configuration>Debug+Cycles</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="ReleaseDebuggable+Cycles|x64">
      <Configuration>ReleaseDebuggable+Cycles</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{4374CB1D-D754-4248-811B-A2B660EC79E3}</ProjectGuid>
    <RootNamespace>ccycles</RootNamespace>
    <Keyword>MakeFileProj</Keyword>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'!='Debug'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <!-- build_cycles.ps1 takes Debug / Release / RelWithDebInfo. Debug+Cycles builds
         RelWithDebInfo: an unoptimised kernel makes CPU renders ten times slower,
         and the PDBs keep ccycles steppable. For a true Debug:
             build_cycles.ps1 -Configuration Debug -InstallDir <the local payload> -->
    <CyclesConfiguration>Release</CyclesConfiguration>
    <CyclesConfiguration Condition="$(Configuration.StartsWith('Debug'))">RelWithDebInfo</CyclesConfiguration>
    <CyclesConfiguration Condition="$(Configuration.StartsWith('ReleaseDebuggable'))">RelWithDebInfo</CyclesConfiguration>

    <CyclesScript>$(MSBuildThisFileDirectory)..\..\build_cycles.ps1</CyclesScript>
    <!-- A Makefile project imports no Rhino property sheets, so RhinoBinDir is
         empty from Rhino.sln. Derive bin from this file; RhinoBinDir wins if set.
           src/ccycles -> src -> cycles-core -> RDK -> Plug-ins -> rhino4 -> src4 -->
    <CyclesBinDir Condition="'$(RhinoBinDir)'!=''">$(RhinoBinDir)</CyclesBinDir>
    <CyclesBinDir Condition="'$(RhinoBinDir)'==''">$(MSBuildThisFileDirectory)..\..\..\..\..\..\bin</CyclesBinDir>
    <!-- Rhino.sln builds RhinoCyclesCore as Release in ReleaseDebuggable, so bin/Release. -->
    <CyclesDeployConfiguration>Release</CyclesDeployConfiguration>
    <CyclesDeployConfiguration Condition="$(Configuration.StartsWith('Debug'))">Debug</CyclesDeployConfiguration>
    <CyclesDeployDir>$(CyclesBinDir)\$(CyclesDeployConfiguration)\Plug-ins</CyclesDeployDir>
    <!-- Install into big_libs, where the prebuilt Cycles lives, so a rebuilt Cycles
         reaches bin through RhinoCyclesCore like everyone else's. Always the gitignored
         "local" payload, which RhinoCyclesCore prefers while it is newer than the
         committed "release" one; only publish_payload.ps1 writes that. -->
    <CyclesInstallDir>$(MSBuildThisFileDirectory)..\..\..\..\..\..\..\big_libs\RhinoCycles\ccycles\win\local</CyclesInstallDir>
    <CyclesBuildDir>$(MSBuildThisFileDirectory)..\..\build</CyclesBuildDir>

    <!-- Only the +Cycles configurations build from source (see the top of this
         file). Not detected automatically: a Makefile project declares no sources
         for MSBuild to compare, and checkout rewrites mtimes. -->
    <CyclesBuildFromSource>false</CyclesBuildFromSource>
    <CyclesBuildFromSource Condition="$(Configuration.Contains('Cycles'))">true</CyclesBuildFromSource>

    <CyclesInvoke>powershell -NoProfile -ExecutionPolicy Bypass -File "$(CyclesScript)" -Configuration $(CyclesConfiguration) -InstallDir "$(CyclesInstallDir)"</CyclesInvoke>
    <CyclesSkipMessage>echo ccycles: using the prebuilt Cycles from big_libs. Build Cycles.sln, or the Debug+Cycles or ReleaseDebuggable+Cycles configuration, to build it from source.</CyclesSkipMessage>

    <NMakeBuildCommandLine Condition="'$(CyclesBuildFromSource)'=='true'">$(CyclesInvoke)</NMakeBuildCommandLine>
    <NMakeBuildCommandLine Condition="'$(CyclesBuildFromSource)'!='true'">$(CyclesSkipMessage)</NMakeBuildCommandLine>

    <NMakeReBuildCommandLine Condition="'$(CyclesBuildFromSource)'=='true'">rmdir /s /q "$(CyclesBuildDir)" 2&gt;nul &amp; $(CyclesInvoke)</NMakeReBuildCommandLine>
    <NMakeReBuildCommandLine Condition="'$(CyclesBuildFromSource)'!='true'">$(CyclesSkipMessage)</NMakeReBuildCommandLine>

    <NMakeCleanCommandLine Condition="'$(CyclesBuildFromSource)'=='true'">rmdir /s /q "$(CyclesBuildDir)" 2&gt;nul</NMakeCleanCommandLine>
    <NMakeCleanCommandLine Condition="'$(CyclesBuildFromSource)'!='true'">$(CyclesSkipMessage)</NMakeCleanCommandLine>

    <NMakeOutput>$(CyclesInstallDir)\ccycles.dll</NMakeOutput>

    <!-- Gives IntelliSense something to work with when browsing ccycles sources. -->
    <NMakePreprocessorDefinitions>CCL_CAPI_DLL;WITH_CUDA_DYNLOAD;$(NMakePreprocessorDefinitions)</NMakePreprocessorDefinitions>
    <NMakeIncludeSearchPath>$(MSBuildThisFileDirectory)cycles\src;$(MSBuildThisFileDirectory)cycles\third_party;$(NMakeIncludeSearchPath)</NMakeIncludeSearchPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\build_cycles.ps1" />
    <None Include="CMakeLists.txt" />
    <None Include="ccycles_manifest.xml.in" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!--
    RhinoCyclesCore's deploy targets read only its properties, not its build output, so
    they run without building it. A Makefile project's Rebuild does not run Build.
    No Rhino build to refresh: the first one deploys the payload itself.
  -->
  <Target Name="DeployToRhinoBin" AfterTargets="Build;Rebuild" Condition="'$(CyclesBuildFromSource)'=='true'">
    <MSBuild Condition="Exists('$(CyclesDeployDir)')"
             Projects="$(MSBuildThisFileDirectory)..\..\..\RhinoCycles\RhinoCyclesCore.csproj"
             Targets="DeployCyclesPayload"
             Properties="Configuration=$(CyclesDeployConfiguration);Platform=AnyCPU" />
    <Message Condition="!Exists('$(CyclesDeployDir)')" Importance="high"
             Text="ccycles: no Rhino build in $([MSBuild]::NormalizePath('$(CyclesBinDir)', '$(CyclesDeployConfiguration)')), so Cycles was not deployed. Building Rhino.sln deploys it." />
  </Target>
</Project>
