// Version resources for ccycles.dll, compiled in by src/ccycles/CMakeLists.txt.
// The version numbers and copyright information come from the header below.
//
// The path is relative to this file: src/ccycles -> src4, given this repo is
// checked out as Rhino's RDK/cycles submodule. Rhino generates src4/version.h
// during its build, so it only resolves inside a Rhino tree; CMake defines
// STANDALONE when it is absent, falling back to the version.h beside this file.
#if !defined(STANDALONE)
#include "..\..\..\..\..\..\version.h"
#else
#include "version.h"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_WITH_COMMAS
 PRODUCTVERSION VERSION_WITH_COMMAS
 FILEFLAGSMASK RHINO_FILE_FLAGS_MASK
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904e4"
        BEGIN
            VALUE "CompanyName", "Robert McNeel & Associates"
            VALUE "FileDescription", "ccycles - C API for Cycles"
            // Quoted form: VERSION_WITH_PERIODS is an unquoted token, and RC accepts
            // it here but produces a StringFileInfo block that readers cannot parse -
            // the file version came out blank in Explorer and FileVersionInfo.
            VALUE "FileVersion", RMA_VERSION_WITH_PERIODS_STRING
            VALUE "InternalName", "ccycles.dll"
            VALUE "LegalCopyright", COPYRIGHT
            VALUE "OriginalFilename", "ccycles.dll"
            VALUE "ProductName", "Cycles for Rhino"
            VALUE "ProductVersion", RMA_VERSION_WITH_PERIODS_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1252
    END
END
