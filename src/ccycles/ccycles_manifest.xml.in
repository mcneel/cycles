<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<!--
  Win32 side-by-side private assembly manifest for ccycles. Rhino loads its own
  OpenImageIO, OpenEXR and TBB into the same process; as assembly members, the
  Cycles copies resolve within this assembly, not by bare filename, so both coexist.
  This covers ccycles.dll's own imports only; fix-cycles-sxs.ps1 gives the DLLs
  it loads manifests of their own after every install.

  Generated by CMake, members from CCYCLES_SXS_FILES in CMakeLists.txt. Edit
  ccycles_manifest.xml.in, not the generated file.
-->
<assembly xmlns='urn:schemas-microsoft-com:asm.v1' manifestVersion='1.0'>
  <assemblyIdentity type="win32" name="ccycles" version="@CCYCLES_ASSEMBLY_VERSION@" processorArchitecture="amd64" />
@CCYCLES_SXS_FILE_ELEMENTS@
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level='asInvoker' uiAccess='false' />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
